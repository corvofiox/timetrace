# 多阶段构建 - 构建阶段
FROM node:18-alpine AS backend-builder

# 设置后端工作目录
WORKDIR /app/backend

# 复制后端package.json和package-lock.json
COPY backend/package*.json ./

# 安装后端依赖
RUN npm ci --only=production

# 复制后端源代码
COPY backend/src ./src

# 生产阶段
FROM node:18-alpine AS production

# 安装Python和必要的工具
RUN apk add --no-cache python3 py3-pip

# 创建应用目录
WORKDIR /app

# 从构建阶段复制后端
COPY --from=backend-builder /app/backend ./backend

# 复制前端文件
COPY . ./

# 移除不需要的文件
RUN rm -f Dockerfile.single docker-compose.yml .dockerignore backend/Dockerfile backend/.dockerignore

# 创建数据目录
RUN mkdir -p data

# 暴露端口
EXPOSE 3000 8000

# 设置环境变量
ENV NODE_ENV=production
ENV JWT_SECRET=d8qlkD7mAqwxim9e+IndzhjNAWVHH0uNQnrkHxIwII0=
ENV JWT_EXPIRE=15m
ENV REFRESH_TOKEN_SECRET=/7E7j8lwAMsEazBqw522mfzRD3d3ma3BD1pBYwKLI70=
ENV REFRESH_TOKEN_EXPIRE=7d

# 使用脚本同时启动前端和后端
CMD ["sh", "-c", "cd backend && npm start & cd frontend && python3 -m http.server 8000 & wait"]