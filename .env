# 环境变量配置文件

# 开发环境 - 复制此文件为 .env 并填入实际值
# 生产环境 - 请使用强随机密钥

# 服务器端口
PORT=3000

# JWT密钥配置 (生产环境请使用强随机字符串)
JWT_SECRET=change_me_in_production
JWT_EXPIRE=15m

# 刷新令牌密钥配置 (生产环境请使用强随机字符串)
REFRESH_TOKEN_SECRET=change_me_in_production
REFRESH_TOKEN_EXPIRE=7d

# 数据存储目录
DATA_DIR=./data

# MongoDB连接字符串 (如果使用MongoDB而非文件存储)
# MONGODB_URI=mongodb://localhost:27017/calendar-app