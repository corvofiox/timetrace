# 环境变量示例文件
# 复制此文件为 .env 并填入实际值

# 服务器端口
PORT=3000

# JWT密钥配置（可选）
# 如果不提供，系统将在首次启动时自动生成强随机密钥
# 生产环境建议手动设置以确保密钥的一致性
JWT_SECRET=
JWT_EXPIRE=15m

# 刷新令牌密钥配置（可选）
# 如果不提供，系统将在首次启动时自动生成强随机密钥
# 生产环境建议手动设置以确保密钥的一致性
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRE=7d

# 数据存储目录 (可选，默认为 ./data)
DATA_DIR=./data

# MongoDB连接字符串 (如果使用MongoDB而非文件存储)
# MONGODB_URI=mongodb://localhost:27017/calendar-app