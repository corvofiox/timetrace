# 环境变量示例文件
# 复制此文件为 .env 并填入实际值

# 服务器端口
PORT=3000

# JWT密钥配置 (请使用强随机字符串)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=15m

# 刷新令牌密钥配置 (请使用强随机字符串)
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRE=7d

# 数据存储目录 (可选，默认为 ./data)
DATA_DIR=./data

# MongoDB连接字符串 (如果使用MongoDB而非文件存储)
# MONGODB_URI=mongodb://localhost:27017/calendar-app